# ReproKit environment
# Copy to .env and fill in. NEVER commit .env.

# ---- app ----
APP_ENV=development                  # development | production
APP_BASE_URL=http://localhost:8000   # in production: https://reprokit.tech
SESSION_SECRET=change-me-to-a-long-random-string

# ---- database ----
# Leave unset in development to use local SQLite (reprokit.db).
# In production use the Supabase *pooler* connection string (port 6543, sslmode=require).
DATABASE_URL=

# ---- supabase (optional; only if you use supabase-py instead of psycopg) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only. NEVER expose to the browser.
SUPABASE_ANON_KEY=                  # not used by ReproKit v1 — no auth, no client-side DB access

# ---- github ----
# Optional. Raises the REST rate limit from 60/hr to 5000/hr for public issue reads.
# Create a fine-grained token with NO scopes (public read only). Never commit it.
GITHUB_TOKEN=

# ---- llm (optional; gap analysis degrades gracefully to heuristics without it) ----
LLM_PROVIDER=                       # openai | none
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# ---- retention ----
REPORT_RETENTION_DAYS=90            # redacted reports only; raw pasted text is never stored
